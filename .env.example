# IC Verification System Environment Configuration

# Gemini API Key (Get a free key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Service Account Credentials (For Vercel / Render cloud deployments)
# Option 1: Paste full raw JSON string or base64 JSON string
GOOGLE_CREDENTIALS_JSON='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'

# Option 2: Individual variables
# GOOGLE_CLIENT_EMAIL=ic-data@ic-income-data.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Option 3: Local keyfile path (for local development)
# GOOGLE_APPLICATION_CREDENTIALS=server/config/google_credentials.json

# Express Server Port
PORT=5000

# Production Backend API URL (leave empty if deploying frontend & API together on Vercel, or set to your Render URL if hosted on Render)
VITE_API_URL=
