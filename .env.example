# IC Verification System Environment Configuration

# Gemini API Key (Get a free key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Express Server Port
PORT=5000

# Production Backend API URL (leave empty for local dev proxy, set to your Render API URL in production)
VITE_API_URL=https://ic-verify-api.onrender.com

